# Copy these into your shell / IDE run configuration. Do NOT commit real values.
DB_URL=jdbc:mysql://localhost:3306/mamacare?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=mamacare
DB_PASSWORD=change-me
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=120
# First administrator is created at startup only if no ADMIN exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Admin-123
STORAGE_DIR=./data/private-uploads
REQUIRE_PATIENT_APPROVAL=false
